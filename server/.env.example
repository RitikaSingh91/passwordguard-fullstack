# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/passwordguard
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
CLIENT_ORIGIN=http://localhost:5173
ACCESS_TTL=15m
REFRESH_DAYS=7
# lax for same-site deployments, none (requires HTTPS) when client and API are on different sites
COOKIE_SAMESITE=lax
# Only used by `npm run seed:admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=
